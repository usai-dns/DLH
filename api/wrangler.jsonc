{
  "name": "dlh-api",
  "account_id": "f1d19cc490b902a854ac1b43b5808673",
  "compatibility_date": "2026-07-04",
  "main": "src/index.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dlh-db",
      "database_id": "2d05bbc1-dbbb-4dd5-91ef-9d842da04c92"
    }
  ],
  // Same template packages the serve worker ships; used to read
  // manifest.json / default-config.json. run_worker_first keeps every
  // request in the worker (assets are internal, not directly served).
  "assets": {
    "directory": "../templates",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SERVE_BASE_URL": "https://dlh-serve.usai-dlh.workers.dev",
    "PORTAL_BASE_URL": "https://dlh-portal.pages.dev",
    "STRIPE_MODE": "subscription"
    // Secrets (wrangler secret put, from api/):
    //   STRIPE_SECRET_KEY     — enables payment enforcement
    //   STRIPE_WEBHOOK_SECRET — webhook signature verification
    // Var once Stripe product exists: STRIPE_PRICE_ID
  }
}
